# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env and fill in your actual credentials. NEVER commit .env to Git!
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=4000
WEB_PORT=8000
API_BASE_URL=http://localhost:4000

# ==============================================================================
# MERCHANT BANK SETTLEMENT & PAYOUT CONFIGURATION
# Funds from all organization subscriptions will be directly deposited here
# ==============================================================================
BANK_ACCOUNT_HOLDER="Equisteg Operations LLC"
BANK_NAME="Silicon Valley Bank / Standard Chartered"
BANK_ACCOUNT_NUMBER="00112233445566"
BANK_ROUTING_OR_IFSC="SVBLUS33 / HDFC0001234"
BANK_SWIFT_BIC="SVBLUS33XXX"
BANK_SETTLEMENT_CURRENCY="USD"
BANK_SETTLEMENT_COUNTRY="US"

# ==============================================================================
# PAYMENT GATEWAY API KEYS (STRIPE / RAZORPAY)
# ==============================================================================
# Stripe Keys (https://dashboard.stripe.com/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_here

# Razorpay Keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Zero-Trust Security & Master Auth
JWT_SECRET=super_secret_cryptographic_jwt_signing_key_change_in_production
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SEC=30

# ==============================================================================
# CLOUD BACKEND (Vercel functions in /api) — see docs/CLOUD_SETUP.md
# ==============================================================================
# Supabase Postgres connection string (Project Settings → Database → Connection string → Session pooler).
# Must be the `postgres` user: it creates one schema + optional read-only login per company.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Signs session tokens and OTP hashes. 32+ random characters, e.g. `openssl rand -base64 48`.
# (JWT_SECRET above is reused — replace the placeholder value.)
# Optional separate key for encrypting companies' SMTP passwords at rest (defaults to one derived from JWT_SECRET).
APP_ENCRYPTION_KEY=

# Public URL used in invitation email links (defaults to the request host).
APP_URL=https://your-app.vercel.app

# Platform mailbox: registration OTP emails, and member invites for companies without their own SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@yourdomain.com
SMTP_PASS=app_password_here
SMTP_FROM="Task Tracker <you@yourdomain.com>"

# Subscription pricing charged through Razorpay (RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET above).
BILLING_CURRENCY=USD
PRICE_PER_USER_MONTHLY=1
PRICE_PER_USER_YEARLY=10

# Optional: host/port shown to companies for direct database access (defaults to DATABASE_URL's host/port).
TENANT_DB_HOST=
TENANT_DB_PORT=
