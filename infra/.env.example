# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env and fill in your actual credentials. NEVER commit .env to Git!
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=4000
WEB_PORT=8000
API_BASE_URL=http://localhost:4000

# ==============================================================================
# MERCHANT BANK SETTLEMENT & PAYOUT CONFIGURATION
# Funds from all organization subscriptions will be directly deposited here
# ==============================================================================
BANK_ACCOUNT_HOLDER="Equisteg Operations LLC"
BANK_NAME="Silicon Valley Bank / Standard Chartered"
BANK_ACCOUNT_NUMBER="00112233445566"
BANK_ROUTING_OR_IFSC="SVBLUS33 / HDFC0001234"
BANK_SWIFT_BIC="SVBLUS33XXX"
BANK_SETTLEMENT_CURRENCY="USD"
BANK_SETTLEMENT_COUNTRY="US"

# ==============================================================================
# PAYMENT GATEWAY API KEYS (STRIPE / RAZORPAY)
# ==============================================================================
# Stripe Keys (https://dashboard.stripe.com/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_here

# Razorpay Keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Zero-Trust Security & Master Auth
JWT_SECRET=super_secret_cryptographic_jwt_signing_key_change_in_production
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SEC=30
